# Local storage
UPERFECT_DATABASE_PATH=uperfect.db

# No-cost local-only runtime. Keep the host and Ollama endpoint fixed to the LAN host.
UPERFECT_LOCAL_ONLY=true
UPERFECT_LOCAL_AI_BASE_URL=http://192.168.74.130:11434
UPERFECT_LOCAL_AI_MODEL=zCoder:latest

# Server-side integration configuration. Leave blank until account-owner setup is complete.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_DESTINATION=
# Future inbound LINE webhook adapter; not consumed by this local release.
# LINE_CHANNEL_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
# Future OAuth callback adapter fields; keep server-side when implemented.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REFRESH_TOKEN=
# TIKTOK_REDIRECT_URL=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
# SHOPEE_REDIRECT_URL=
N8N_WEBHOOK_URL=
GEMINI_API_KEY=
